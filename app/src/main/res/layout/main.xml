<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Haupt-Client (Vollbild) -->
    <WebView
        android:id="@+id/webView1"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- F-Tool Button für Hauptaccount -->
    <Button
        android:id="@+id/btnFtoolMain"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:background="#88000000"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:text="FTool 1: OFF"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <!-- Overlay-Container (Zweit-Account) -->
    <LinearLayout
        android:id="@+id/overlayContainer"
        android:layout_width="320dp"
        android:layout_height="220dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="#222226"
        android:orientation="vertical">

        <!-- Obere Leiste: Drag-Handle + Buttons -->
        <LinearLayout
            android:id="@+id/dragHandle"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#33333D"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <!-- Zieh-Bereich / Titel -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="::: Drag here"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnFtoolOverlay"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="#555566"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:text="FT 2: OFF"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnToggleSize"
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="#555566"
                android:text="—"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- WebView des Zweit-Accounts -->
        <WebView
            android:id="@+id/webView2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
